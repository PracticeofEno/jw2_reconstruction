!ranker_reconstructed_code/src/
!ranker_reconstructed_code/src/**

!ranker_reconstructed_code/tests/
!ranker_reconstructed_code/tests/evil_portal_construction_release_regression.cpp
!ranker_reconstructed_code/tests/legacy_udp_burst_regression.cpp
